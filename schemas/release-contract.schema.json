{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://henuos.com/schemas/release-contract.schema.json",
  "title": "HENU Product Release Contract",
  "description": "Validation schema for release metadata across independent HENU software repositories.",
  "type": "object",
  "required": ["productId", "version", "channel", "releaseNotes", "assets"],
  "properties": {
    "productId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case product identifier (e.g., henu-pa, henu-ai, henu-ide)."
    },
    "productName": {
      "type": "string",
      "description": "Human-readable product name."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Strict Semantic Versioning 2.0.0 string."
    },
    "channel": {
      "type": "string",
      "enum": ["stable", "beta", "nightly"],
      "description": "Target release tier."
    },
    "releaseDate": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 publication timestamp."
    },
    "releaseNotes": {
      "type": "string",
      "minLength": 1,
      "description": "Markdown formatted release notes or changelog."
    },
    "minHubVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "Minimum HENU HUB version required to manage and run this application."
    },
    "repository": {
      "type": "object",
      "properties": {
        "owner": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "description": "Collection of binary installable packages conforming to the release contract.",
      "items": {
        "type": "object",
        "required": ["fileName", "os", "arch", "packageFormat", "sha256", "sizeBytes"],
        "properties": {
          "fileName": {
            "type": "string",
            "minLength": 3,
            "description": "Exact file name of the release asset."
          },
          "os": {
            "type": "string",
            "enum": ["windows", "macos", "linux"],
            "description": "Target operating system."
          },
          "arch": {
            "type": "string",
            "enum": ["x86_64", "arm64", "universal"],
            "description": "Target CPU architecture."
          },
          "packageFormat": {
            "type": "string",
            "enum": ["exe", "msi", "dmg", "pkg", "deb", "rpm", "appimage", "tar.gz", "zip"],
            "description": "Supported package format."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Hexadecimal lowercase SHA-256 checksum."
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "description": "Exact asset file size in bytes."
          },
          "downloadUrl": {
            "type": "string",
            "format": "uri",
            "description": "Public HTTPS download URL for the package."
          },
          "installer": {
            "type": "object",
            "properties": {
              "executablePath": { "type": "string" },
              "silentArgs": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
