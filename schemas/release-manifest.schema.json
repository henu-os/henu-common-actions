{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.henuos.in/v1/release-manifest.schema.json",
  "title": "HENU Universal Product Release Specification",
  "description": "Standardized, product-independent release manifest specification for all HENU OS desktop and web applications.",
  "type": "object",
  "required": [
    "schemaVersion",
    "applicationId",
    "applicationVersion",
    "releaseTag",
    "releaseChannel",
    "releaseNotes",
    "publicationTimestamp",
    "applicationType"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference URI."
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Version of the release manifest contract schema."
    },
    "applicationId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique kebab-case application identifier (e.g., 'henu-pa', 'henu-ai', 'henu-ide')."
    },
    "applicationName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Human-readable display title of the application."
    },
    "applicationVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Strict Semantic Versioning 2.0.0 string."
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v?(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9a-zA-Z.-]+)?$",
      "description": "Git release tag (e.g. 'v1.0.0' or '1.0.0')."
    },
    "releaseChannel": {
      "type": "string",
      "enum": ["stable", "beta", "alpha", "nightly"],
      "description": "Target distribution tier."
    },
    "applicationType": {
      "type": "string",
      "enum": ["desktop", "web", "cli", "hybrid"],
      "description": "Application architecture tier."
    },
    "publicationTimestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of release compilation."
    },
    "releaseNotes": {
      "type": "string",
      "minLength": 5,
      "description": "Markdown formatted release changelog and security notes."
    },
    "minHubVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "Minimum HENU HUB client version required to manage this release."
    },
    "repository": {
      "type": "object",
      "required": ["provider", "owner", "name", "commitSha"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "enum": ["github", "gitlab"] },
        "owner": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Exact 40-character hexadecimal git commit SHA building this release."
        }
      }
    },
    "webDeployment": {
      "type": "object",
      "required": ["webAppUrl"],
      "additionalProperties": false,
      "description": "Web application target parameters (required when applicationType is 'web').",
      "properties": {
        "webAppUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "Authoritative HTTPS URL where the web application is hosted."
        },
        "entrypoint": {
          "type": "string",
          "description": "Web entrypoint file (e.g. index.html or server.js)."
        },
        "bundleArchive": {
          "type": "object",
          "description": "Optional packaged web distribution tarball for rollback and edge deployment archiving.",
          "required": ["downloadUrl", "fileName", "sizeBytes", "sha256"],
          "additionalProperties": false,
          "properties": {
            "downloadUrl": { "type": "string", "format": "uri" },
            "fileName": { "type": "string" },
            "sizeBytes": { "type": "integer", "minimum": 1 },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "not": {
                "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
              }
            }
          }
        },
        "serviceWorkerScope": {
          "type": "string",
          "description": "Optional Progressive Web App service worker scope."
        },
        "browserSupport": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Supported browser engines (e.g., Chromium >= 105, Safari >= 15, Firefox >= 100)."
        }
      }
    },
    "updateCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minUpgradableVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "description": "Oldest version that can safely upgrade in-place to this release."
        },
        "requiresRestart": {
          "type": "boolean",
          "default": false,
          "description": "Whether host system or client shell restart is required."
        },
        "checkRunningProcess": {
          "type": "boolean",
          "default": true,
          "description": "Whether HUB client must verify process termination before applying upgrade."
        }
      }
    },
    "assets": {
      "type": "array",
      "description": "List of compiled platform packages (required for desktop applications).",
      "items": {
        "$ref": "#/$defs/ReleaseAsset"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "applicationType": { "const": "desktop" } }
      },
      "then": {
        "required": ["assets"],
        "properties": {
          "assets": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "applicationType": { "const": "web" } }
      },
      "then": {
        "required": ["webDeployment"]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "ReleaseAsset": {
      "type": "object",
      "required": [
        "fileName",
        "os",
        "arch",
        "packageFormat",
        "downloadUrl",
        "sizeBytes",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 4,
          "description": "Canonical artifact file name adhering to HENU naming standards."
        },
        "os": {
          "type": "string",
          "enum": ["windows", "macos", "linux"],
          "description": "Target host operating system."
        },
        "arch": {
          "type": "string",
          "enum": ["x86_64", "arm64", "universal"],
          "description": "Target processor architecture."
        },
        "packageFormat": {
          "type": "string",
          "enum": [
            "exe",
            "msi",
            "zip",
            "dmg",
            "pkg",
            "appimage",
            "deb",
            "tar.gz"
          ],
          "description": "Package container or installer format."
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?!.*(\\.(example|test|invalid|localhost)|://localhost(:|/|$))).+",
          "description": "Authoritative HTTPS download link (no HTTP, no mock/placeholder domains in production)."
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Exact file size in bytes."
        },
        "sha256": {
          "type": "string",
          "pattern": "^(?!e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855$)[a-f0-9]{64}$",
          "description": "Cryptographic SHA-256 digest in lowercase hexadecimal (empty hash e3b0c44... rejected)."
        },
        "minOsVersion": {
          "type": "string",
          "description": "Minimum required OS build (e.g. '10.0.19041' for Windows 10 20H2, '12.0' for macOS Monterey, 'glibc-2.31' for Linux)."
        },
        "installer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executablePath": {
              "type": "string",
              "description": "Relative path to target executable after extraction/installation."
            },
            "silentArgs": {
              "type": "array",
              "items": { "type": "string" },
              "description": "CLI flags passed to installer for silent unattended execution."
            },
            "installDirectory": {
              "type": "string",
              "description": "Default installation target directory."
            }
          }
        },
        "signature": {
          "type": "object",
          "required": ["type", "signatureUrl"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "authenticode",
                "apple_notarization",
                "gpg",
                "minisign",
                "cosign"
              ]
            },
            "signatureUrl": {
              "type": "string",
              "format": "uri"
            },
            "publicKey": {
              "type": "string"
            },
            "verified": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "provenance": {
          "type": "object",
          "required": ["attestationUrl", "builderId", "slsaLevel"],
          "additionalProperties": false,
          "properties": {
            "attestationUrl": {
              "type": "string",
              "format": "uri"
            },
            "builderId": {
              "type": "string"
            },
            "slsaLevel": {
              "type": "string",
              "enum": ["SLSA_LEVEL_1", "SLSA_LEVEL_2", "SLSA_LEVEL_3"]
            }
          }
        }
      }
    }
  }
}
